{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zeropoet/FoldKernel/main/Integration/foldkernel-transformation-receipt.schema.json",
  "title": "FoldKernel Transformation Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "digestAlgorithm", "receiptID", "sourceSystem", "eventID",
    "sourceArtifactDigest", "sourceKind", "transitionKind", "evidenceDigest", "occurredOn",
    "sourcePreserved", "destructive", "transferable", "purchasable", "appreciating",
    "monetary", "personalData"
  ],
  "properties": {
    "contractVersion": { "const": "FoldKernel-Transformation-Receipt-1.0.0" },
    "digestAlgorithm": { "const": "keccak-256" },
    "receiptID": { "$ref": "#/$defs/digest" },
    "sourceSystem": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$" },
    "eventID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" },
    "sourceArtifactDigest": { "$ref": "#/$defs/digest" },
    "sourceKind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "transitionKind": { "enum": ["transformed", "fulfilled", "consumed", "superseded", "retired"] },
    "outputArtifactDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "outputKind": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "occurredOn": { "$ref": "#/$defs/date" },
    "sourcePreserved": { "const": true },
    "destructive": { "const": false },
    "transferable": { "const": false },
    "purchasable": { "const": false },
    "appreciating": { "const": false },
    "monetary": { "const": false },
    "personalData": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "transitionKind": { "enum": ["transformed", "fulfilled"] } } },
      "then": { "required": ["outputArtifactDigest", "outputKind"] }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
