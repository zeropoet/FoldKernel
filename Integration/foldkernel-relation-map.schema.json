{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foldkernel.zeropoet.xyz/Integration/foldkernel-relation-map.schema.json",
  "title": "FoldKernel Relation Map 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "coreProtocolVersion",
    "digestAlgorithm",
    "relationMapID",
    "uniqueObservationCount",
    "relations",
    "nodes"
  ],
  "properties": {
    "contractVersion": {
      "const": "FoldKernel-Relation-1.1.0"
    },
    "coreProtocolVersion": {
      "const": "FoldKernel-1.0.0"
    },
    "digestAlgorithm": {
      "const": "keccak-256"
    },
    "relationMapID": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "uniqueObservationCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceIdentity",
          "targetIdentity",
          "kind",
          "weight"
        ],
        "properties": {
          "sourceIdentity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "targetIdentity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$",
            "minLength": 1,
            "maxLength": 64
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "mass"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "mass": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    }
  }
}
